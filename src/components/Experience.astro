---
import { t } from 'i18next';
import { ExperienceInfo } from '../consts';
---

<section id="experience" class="border-t border-line">
	<div class="max-w-page mx-auto px-4 sm:px-8 py-20 sm:py-28">
		<h2 class="font-wide font-bold text-3xl sm:text-4xl tracking-tight">
			{t('experience.title')}
		</h2>

		<!-- Newest first; each job is a stop on the route -->
		<ol class="mt-12 relative border-l-[3px] border-line ml-[6px] space-y-14">
			{
				ExperienceInfo.map((job, index) => (
					<li class="relative pl-8 sm:pl-12">
						<span
							class:list={[
								'absolute -left-[10.5px] top-1.5 w-[18px] h-[18px] rounded-full',
								index === 0 ? 'bg-signal ring-[3px] ring-ink' : 'bg-bg border-[3px] border-ink',
							]}
							aria-hidden="true"
						/>
						<div class="grid gap-2 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-10">
							<p class="text-muted text-sm sm:text-base pt-0.5 tabular-nums">{t(job.dates)}</p>
							<div class="max-w-[40rem]">
								<h3 class="text-xl font-bold">
									{t(job.role)}
									<span class="font-normal text-muted"> · {job.company}</span>
								</h3>
								<p class="text-sm text-muted mt-1">{t(job.location)}</p>
								<p class="mt-3 text-lg leading-relaxed">{t(job.summary)}</p>
								<p class="mt-3 text-sm text-muted">{job.stack.join(', ')}</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
