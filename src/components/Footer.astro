---
import { t } from 'i18next';
import { EMAIL, contactLinks } from '../consts';
---

<footer id="contact" class="border-t border-line">
	<div class="max-w-page mx-auto px-4 sm:px-8 py-20 sm:py-28">
		<h2 class="font-wide font-bold text-3xl sm:text-4xl tracking-tight">
			{t('footer.title')}
		</h2>
		<p class="mt-3 text-lg text-muted max-w-[38rem]">{t('footer.intro')}</p>

		<a
			href={`mailto:${EMAIL}`}
			class="mt-10 inline-block font-wide font-bold text-[clamp(1.25rem,4.4vw,2.75rem)] tracking-tight break-all underline decoration-signal decoration-[5px] underline-offset-[10px] hover:decoration-ink transition-colors"
		>
			{EMAIL}
		</a>

		<ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-lg font-semibold">
			{
				contactLinks.map((link) => (
					<li>
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="text-link underline underline-offset-4 decoration-2 hover:decoration-signal"
						>
							{link.name}
						</a>
					</li>
				))
			}
		</ul>

		<p class="mt-20 text-sm text-muted">
			© {new Date().getFullYear()} Justo Juan Becerra
		</p>
	</div>
</footer>
