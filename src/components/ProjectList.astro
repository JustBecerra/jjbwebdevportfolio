---
import { t } from 'i18next';
import { ChallengeInfo, ProfessionalInfo } from '../consts';
import ProjectCard from './ProjectCard.astro';
---

<section id="work" class="border-t border-line">
	<div class="max-w-page mx-auto px-4 sm:px-8 py-20 sm:py-28">
		<h2 class="font-wide font-bold text-3xl sm:text-4xl tracking-tight">
			{t('projects.clientTitle')}
		</h2>
		<p class="mt-3 text-lg text-muted max-w-[38rem]">{t('projects.clientIntro')}</p>

		<div class="mt-14 space-y-20">
			{ProfessionalInfo.map((info) => <ProjectCard project={info} variant="client" />)}
		</div>

		<h2 class="mt-28 font-wide font-bold text-2xl sm:text-3xl tracking-tight">
			{t('projects.personalTitle')}
		</h2>
		<p class="mt-3 text-lg text-muted max-w-[38rem]">{t('projects.personalIntro')}</p>

		<div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
			{ChallengeInfo.map((info) => <ProjectCard project={info} variant="personal" />)}
		</div>
	</div>
</section>
