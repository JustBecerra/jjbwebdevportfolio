---
import { t } from 'i18next';
import type { Project } from '../consts';

interface Props {
	project: Project;
	variant: 'client' | 'personal';
}

const { project, variant } = Astro.props;
const isClient = variant === 'client';
---

<article
	class:list={[
		isClient && 'grid gap-8 md:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] md:gap-12 md:items-center',
	]}
>
	<div class="overflow-hidden rounded-md border border-line bg-surface">
		<img
			src={project.imageURL}
			alt={t('projects.screenshotAlt', { name: project.name })}
			width="1920"
			height="950"
			loading="lazy"
			decoding="async"
			class="w-full h-auto aspect-[1920/950] object-cover object-top"
		/>
	</div>

	<div class:list={[!isClient && 'mt-5']}>
		<div class="flex items-center gap-3">
			<img src={project.projectIcon} width="28" height="28" alt="" class="w-7 h-7 rounded object-contain" />
			<p class="text-sm text-muted">{t(project.type)}</p>
		</div>
		<h3
			class:list={[
				'mt-3 font-bold tracking-tight',
				isClient ? 'font-wide text-2xl sm:text-3xl' : 'text-xl',
			]}
		>
			{project.name}
		</h3>
		<p class:list={['mt-3 leading-relaxed max-w-[36rem]', isClient ? 'text-lg' : 'text-base text-muted']}>
			{t(project.description)}
		</p>
		<ul class="mt-4 flex flex-wrap gap-2" aria-label={t('projects.tech')}>
			{
				project.stack.map((tech) => (
					<li class="text-sm px-2.5 py-1 rounded border border-line text-muted">{tech}</li>
				))
			}
		</ul>
		{
			(project.appLink || project.repoLink || project.note) && (
				<div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-semibold">
					{project.appLink && (
						<a
							href={project.appLink}
							target="_blank"
							rel="noopener noreferrer"
							class="text-link underline underline-offset-4 decoration-2 hover:decoration-signal"
						>
							{t(project.appLabel ?? 'projects.visitSite')}
						</a>
					)}
					{project.repoLink && (
						<a
							href={project.repoLink}
							target="_blank"
							rel="noopener noreferrer"
							class="text-link underline underline-offset-4 decoration-2 hover:decoration-signal"
						>
							{t('projects.viewCode')}
						</a>
					)}
					{project.note && <span class="font-normal text-sm text-muted">{t(project.note)}</span>}
				</div>
			)
		}
	</div>
</article>
